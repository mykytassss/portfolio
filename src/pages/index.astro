---
import { copy, profile } from '../data/profile';
import '../styles/global.css';

const base = import.meta.env.BASE_URL;
const canonical = new URL(base, Astro.site);
const year = new Date().getUTCFullYear();
const navigation = [
  { id: 'about', label: copy.about },
  { id: 'projects', label: copy.projects },
  { id: 'contacts', label: copy.contacts },
];
---

<!doctype html>
<html lang={copy.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={copy.metaDescription} />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:title" content={copy.metaTitle} />
    <meta property="og:description" content={copy.metaDescription} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={profile.avatar.src} />
    <meta property="og:image:alt" content={profile.avatar.alt} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href={`${base}images/mark.svg`} type="image/svg+xml" />
    <title>{copy.metaTitle}</title>
    <script is:inline>
      try {
        const theme = localStorage.getItem('portfolio-theme');
        if (theme === 'dark' || theme === 'light') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{copy.skip}</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href={base} aria-label={`${profile.name}. — ${copy.home}`}>
          <span class="brand-mark" data-mark={profile.mark} aria-hidden="true"></span>
          <span aria-hidden="true">{profile.name}<span class="accent">.</span></span>
        </a>
        <nav aria-label={copy.nav}>
          {navigation.map(({ id, label }) => <a href={`#${id}`}>{label}</a>)}
        </nav>
        <button class="theme-toggle" type="button" aria-label={copy.theme} aria-pressed="false" hidden>
          <svg class="moon" viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 13.2A9 9 0 1 1 10.8 3 7 7 0 0 0 21 13.2Z" />
          </svg>
          <svg class="sun" viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4m0-14.2-1.4 1.4M6.3 17.7l-1.4 1.4" />
          </svg>
        </button>
      </div>
    </header>

    <main id="main" class="shell" tabindex="-1">
      <section class="hero" aria-labelledby="intro-heading">
        <div class="hero-content">
          <p class="eyebrow"><span></span>{copy.heroLabel}</p>
          <h1 id="intro-heading">{copy.greeting}<br />{profile.name}<span class="accent">.</span></h1>
          <p class="hero-role">{profile.role}</p>
          <p class="hero-intro">{profile.intro}</p>
          <div class="hero-actions">
            <a class="button primary" href="#projects">{copy.projects}<span aria-hidden="true">↓</span></a>
            <a class="button" href="#contacts">{copy.contactAction}<span aria-hidden="true">↓</span></a>
          </div>
        </div>
        <div class="hero-art" aria-hidden="true">
          <svg viewBox="0 0 400 320" fill="none">
            <g class="art-orbit">
              <circle cx="200" cy="160" r="121" />
              <circle cx="200" cy="160" r="96" stroke-dasharray="2 6" />
              <path d="M42 160h316M200 31v258" stroke-dasharray="3 6" />
            </g>
            <g class="art-frame">
              <rect x="112" y="105" width="192" height="133" rx="16" />
              <rect x="96" y="89" width="192" height="133" rx="16" />
              <path d="M96 117h192" />
            </g>
            <g class="art-ink">
              <circle cx="111" cy="103" r="2.5" /><circle cx="121" cy="103" r="2.5" /><circle cx="131" cy="103" r="2.5" />
              <path d="m164 153-17 17 17 17m56-34 17 17-17 17m-20-42-16 50" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
              <path d="M200 33v12m-6-6h12m115 115v12m-6-6h12M71 154v12m-6-6h12m123 109v12m-6-6h12" fill="none" stroke="currentColor" stroke-width="1.5" />
              <circle cx="114.5" cy="245.5" r="3" /><circle cx="285.5" cy="74.5" r="3" />
            </g>
          </svg>
        </div>
      </section>

      <section id="about" class="section" aria-labelledby="about-heading">
        <h2 id="about-heading"><span class="section-index" aria-hidden="true">01 /</span>{copy.about}</h2>
        <div class="about-grid">
          <img class="avatar" src={profile.avatar.src} alt={profile.avatar.alt} width="144" height="144" loading="lazy" decoding="async" />
          <div class="about-copy">
            {profile.about.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </div>
      </section>

      <section id="skills" class="section" aria-labelledby="skills-heading">
        <h2 id="skills-heading"><span class="section-index" aria-hidden="true">02 /</span>{copy.skills}</h2>
        <div class="skills-grid">
          {profile.skills.map(({ title, items }) => (
            <div class="skill-group">
              <h3>{title}</h3>
              <ul class="tags" role="list">{items.map((item) => <li>{item}</li>)}</ul>
            </div>
          ))}
        </div>
      </section>

      <section id="projects" class="section" aria-labelledby="projects-heading">
        <h2 id="projects-heading"><span class="section-index" aria-hidden="true">03 /</span>{copy.projects}</h2>
        <p class="section-note">{copy.exampleProjects}</p>
        <div class="projects-grid">
          {profile.projects.map(({ title, description, image, stack, links }) => (
            <article class="project">
              <img class="project-image" src={`${base}images/${image.file}`} alt={image.alt} width="640" height="360" loading="lazy" decoding="async" />
              <div class="project-body">
                <h3>{title}</h3>
                <p>{description}</p>
                <ul class="tags" role="list">{stack.map((item) => <li>{item}</li>)}</ul>
                <ul class="project-links" role="list">
                  {links.map(({ label, href }) => (
                    <li>{href ? <a href={href} target="_blank" rel="noopener noreferrer">{label} <span aria-hidden="true">↗</span><span class="visually-hidden">{copy.newTab}</span></a> : <span class="link-pending">{label}<span class="soon">{copy.soon}</span></span>}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section id="experience" class="section" aria-labelledby="experience-heading">
        <h2 id="experience-heading"><span class="section-index" aria-hidden="true">04 /</span>{copy.experience}</h2>
        <p class="section-note">{copy.exampleExperience}</p>
        <ol class="timeline" role="list">
          {profile.experience.map(({ place, role, period, results }) => (
            <li class="timeline-entry">
              <p class="timeline-period">{period}</p>
              <h3>{role}</h3>
              <p class="timeline-place">{place}</p>
              <ul>{results.map((result) => <li>{result}</li>)}</ul>
            </li>
          ))}
        </ol>
      </section>

      <section id="contacts" class="section contacts" aria-labelledby="contacts-heading">
        <h2 id="contacts-heading"><span class="section-index" aria-hidden="true">05 /</span>{copy.contacts}</h2>
        <p class="section-note">{copy.contactIntro}</p>
        <ul class="contact-list" role="list">
          {profile.contacts.map(({ label, href }) => (
            <li>{href ? <a class="button" href={href} target="_blank" rel="noopener noreferrer">{label}<span aria-hidden="true">↗</span><span class="visually-hidden">{copy.newTab}</span></a> : <span class="contact-placeholder">{label}<span class="soon">{copy.soon}</span></span>}</li>
          ))}
        </ul>
      </section>
    </main>

    <footer class="site-footer">
      <div class="shell footer-inner">
        <span>© {year} {profile.name}</span>
        <a href={profile.source} target="_blank" rel="noopener noreferrer">{copy.source} <span aria-hidden="true">↗</span><span class="visually-hidden">{copy.newTab}</span></a>
      </div>
    </footer>

    <script>
      const root = document.documentElement;
      const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
      const system = window.matchMedia('(prefers-color-scheme: dark)');
      const isDark = () => root.dataset.theme ? root.dataset.theme === 'dark' : system.matches;
      const update = () => toggle?.setAttribute('aria-pressed', String(isDark()));

      if (toggle) {
        update();
        toggle.hidden = false;
        toggle.addEventListener('click', () => {
          const theme = isDark() ? 'light' : 'dark';
          root.dataset.theme = theme;
          try {
            localStorage.setItem('portfolio-theme', theme);
          } catch {}
          update();
        });
        system.addEventListener('change', update);
      }

      const header = document.querySelector('.site-header');
      if (header) {
        new ResizeObserver(() => {
          root.style.setProperty('--header-height', `${header.getBoundingClientRect().height}px`);
        }).observe(header);
      }
    </script>
  </body>
</html>
